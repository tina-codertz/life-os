{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "import/no-cycle": "error",
    "typescript/no-extraneous-class": [
      "warn",
      {
        "allowWithDecorator": true
      }
    ]
  },
  "ignorePatterns": ["**/generated/**", "**/dist/**", "**/.expo/**", "**/node_modules/**"],
  "overrides": [
    {
      "files": ["apps/api/**"],
      "env": {
        "node": true
      },
      "rules": {
        "no-underscore-dangle": [
          "warn",
          {
            "allow": ["_count", "_all", "_sum"]
          }
        ]
      }
    },
    {
      "files": ["apps/mobile/**"],
      "plugins": ["react", "jsx-a11y"],
      "env": {
        "browser": true
      },
      "rules": {
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "warn",
        "react/react-in-jsx-scope": "off",
        "react/style-prop-object": [
          "warn",
          {
            "allow": ["StatusBar"]
          }
        ]
      }
    },
    {
      "files": ["**/*.spec.ts", "**/*.e2e-spec.ts"],
      "env": {
        "vitest": true
      },
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["apps/mobile/**/*.test.ts", "apps/mobile/**/*.test.tsx", "apps/mobile/src/test/**"],
      "env": {
        "jest": true
      },
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["apps/mobile/**", "packages/shared/**"],
      "rules": {
        "unicorn/no-array-sort": "off",
        "unicorn/no-array-reverse": "off",
        "no-restricted-properties": [
          "error",
          {
            "property": "toSorted",
            "message": "Expo Go's Hermes engine doesn't have this (Node does, so tests pass but the phone crashes). Use sorted() / reversed() from @/lib/arrays, or a plain loop."
          },
          {
            "property": "toReversed",
            "message": "Expo Go's Hermes engine doesn't have this (Node does, so tests pass but the phone crashes). Use sorted() / reversed() from @/lib/arrays, or a plain loop."
          },
          {
            "property": "toSpliced",
            "message": "Expo Go's Hermes engine doesn't have this (Node does, so tests pass but the phone crashes). Use sorted() / reversed() from @/lib/arrays, or a plain loop."
          },
          {
            "property": "findLast",
            "message": "Expo Go's Hermes engine doesn't have this (Node does, so tests pass but the phone crashes). Use sorted() / reversed() from @/lib/arrays, or a plain loop."
          },
          {
            "property": "findLastIndex",
            "message": "Expo Go's Hermes engine doesn't have this (Node does, so tests pass but the phone crashes). Use sorted() / reversed() from @/lib/arrays, or a plain loop."
          }
        ]
      }
    }
  ]
}
