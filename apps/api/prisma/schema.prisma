// Life OS database schema. Design and reasoning: docs/05-DATABASE-DESIGN.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Identity ─────────────

model User {
  id                    String    @id @default(uuid(7)) @db.Uuid
  email                 String    @unique // stored lowercased (service-enforced)
  passwordHash          String
  displayName           String    @db.VarChar(80)
  emailVerifiedAt       DateTime? @db.Timestamptz(3)
  onboardingCompletedAt DateTime? @db.Timestamptz(3)
  role                  Role      @default(USER)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt             DateTime? @db.Timestamptz(3) // scheduled for purge

  settings   UserSettings?
  sessions   Session[]
  authTokens AuthToken[]
  categories Category[]
  tasks      Task[]
  habits     Habit[]
  goals      Goal[]
  xpEvents   XpEvent[]
}

// One row per refresh token. Logging in starts a *family*; every refresh replaces the row's
// token with a new row in the same family. Only the SHA-256 of the token is stored.
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid // all rotations of one login share this
  refreshTokenHash String    @unique
  deviceName       String?   @db.VarChar(100)
  expiresAt        DateTime  @db.Timestamptz(3)
  rotatedAt        DateTime? @db.Timestamptz(3) // set when replaced → reuse = attack
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// One-time links sent by email (verify address, reset password, confirm a new address). Only the SHA-256 of the
// token is stored; `usedAt` makes each link work once.
model AuthToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime      @db.Timestamptz(3)
  usedAt    DateTime?     @db.Timestamptz(3)
  newEmail  String? // EMAIL_CHANGE only: the address being confirmed (lowercased)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum Role {
  USER
  ADMIN
}

model UserSettings {
  userId               String   @id @db.Uuid
  timezone             String   @default("UTC") // IANA, e.g. "Africa/Dar_es_Salaam"
  followDeviceTimezone Boolean  @default(true)
  weekStartsOn         Int      @default(1) @db.SmallInt // 0=Sun … 6=Sat
  theme                Theme    @default(SYSTEM)
  currency             String   @default("TZS") @db.Char(3) // v1.1
  habitRemindersOn     Boolean  @default(true)
  eventReminderDefault Int?     @db.SmallInt // minutes before
  crashReportsOn       Boolean  @default(true)
  aiEnabled            Boolean  @default(false) // v2
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Theme {
  SYSTEM
  DARK
  LIGHT
}

// ───────────── Organisation ─────────────

// User-defined task groups (FR-TASK-004). Names are unique per user regardless of letter case:
// the service checks case-insensitively; this index catches exact duplicates in a race.
model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  // Case-insensitive (citext), so the unique index below treats "Gym" and "GYM" as the same
  // name, as the app does. Length (50) is checked by the shared schema.
  name      String   @db.Citext
  color     String   @db.VarChar(20) // palette name (packages/shared CATEGORY_COLORS), themed per mode
  icon      String?  @db.VarChar(40)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]
  goals Goal[]

  @@unique([userId, name])
}

// ───────────── Tasks ─────────────

// Tasks I (docs/05). Goal links, subtasks, recurrence and "pinned for today" columns arrive
// with their modules (Goals, Tasks II, Today) as additive migrations.
model Task {
  id                 String       @id @default(uuid(7)) @db.Uuid
  userId             String       @db.Uuid
  title              String       @db.VarChar(200)
  description        String?      @db.VarChar(5000)
  priority           TaskPriority @default(NONE)
  status             TaskStatus   @default(TODO)
  dueDate            DateTime?    @db.Date // the user's local calendar date (ADR-006)
  dueTime            Int?         @db.SmallInt // minutes after local midnight, 0–1439
  completedAt        DateTime?    @db.Timestamptz(3)
  sortOrder          Int          @default(0)
  categoryId         String?      @db.Uuid
  goalId             String?      @db.Uuid // FR-GOAL-004: the goal it counts towards
  milestoneId        String?      @db.Uuid // a step of that goal (always the same goal)
  parentId           String?      @db.Uuid // subtask → parent (one level, service-enforced; FR-TASK-005)
  // Repeating (FR-TASK-006): each occurrence carries the rule; all share the first one's id.
  recurrenceRule     String?      @db.VarChar(200) // RRULE subset, e.g. "FREQ=WEEKLY;BYDAY=MO,WE"
  recurrenceSeriesId String?      @db.Uuid
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?    @db.Timestamptz(3) // soft delete, restorable for 30 days

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  goal      Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parent    Task?      @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks  Task[]     @relation("Subtasks")

  @@index([userId, status, dueDate]) // Today + list filters
  @@index([userId, completedAt]) // history, stats
  @@index([userId, categoryId])
  @@index([goalId])
  @@index([milestoneId])
  @@index([parentId])
  @@index([recurrenceSeriesId])
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  DONE
}

// ───────────── Habits (Habits I; streaks, reminders and stats come in Habits II) ─────────────

model Habit {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @db.Uuid
  name          String    @db.VarChar(80)
  icon          String?   @db.VarChar(40) // a Lucide icon name, e.g. "book-open"
  color         String    @db.VarChar(20) // a palette name (CATEGORY_COLORS), not hex
  targetCount   Int       @default(1) @db.SmallInt // FR-HAB-009, e.g. 8 glasses
  goalDays      Int       @default(21) @db.SmallInt // the quest path's challenge: "Day 12 of 21"
  // FR-HAB-006: minutes after local midnight, sorted; the phone schedules local notifications.
  reminderTimes Int[]     @default([]) @db.SmallInt
  unit          String?   @db.VarChar(20)
  startDate     DateTime  @db.Date // the user's local day; nothing before it is "missed"
  archivedAt    DateTime? @db.Timestamptz(3)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime? @db.Timestamptz(3) // soft delete

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules   HabitSchedule[]
  completions HabitCompletion[]
  goals       GoalHabit[]

  @@index([userId, archivedAt])
}

// Versions of a habit's schedule: a change applies from its day on, so earlier days keep being
// judged by the rule they had (FR-HAB rule 7).
model HabitSchedule {
  id            String         @id @default(uuid(7)) @db.Uuid
  habitId       String         @db.Uuid
  frequency     HabitFrequency
  weekdays      Int[]          @db.SmallInt // WEEKLY_DAYS: 0 = Sunday … 6 = Saturday
  timesPerWeek  Int?           @db.SmallInt // TIMES_PER_WEEK
  effectiveFrom DateTime       @db.Date
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, effectiveFrom])
}

enum HabitFrequency {
  DAILY
  WEEKLY_DAYS
  TIMES_PER_WEEK
}

// One per habit per local day (the unique index makes check-ins safe to repeat).
model HabitCompletion {
  id          String   @id @default(uuid(7)) @db.Uuid
  habitId     String   @db.Uuid
  userId      String   @db.Uuid // copied for fast per-user queries and scoping
  localDate   DateTime @db.Date
  count       Int      @default(1) @db.SmallInt
  completedAt DateTime @default(now()) @db.Timestamptz(3)

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, localDate])
  @@index([userId, localDate])
}

// ───────────── Goals (FR-GOAL; Goals step, docs/05) ─────────────

model Goal {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @db.Uuid
  title          String       @db.VarChar(120)
  description    String?      @db.VarChar(5000)
  status         GoalStatus   @default(ACTIVE)
  progressMode   ProgressMode @default(MILESTONES)
  manualProgress Int?         @db.SmallInt // 0–100 when MANUAL (CHECK in the migration)
  targetDate     DateTime?    @db.Date // the user's local day
  completedAt    DateTime?    @db.Timestamptz(3) // FR-GOAL-005
  categoryId     String?      @db.Uuid
  // v1.1 savings goals add targetAmountMinor + currency here.
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?    @db.Timestamptz(3) // soft delete

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  milestones Milestone[]
  tasks      Task[]
  habits     GoalHabit[]

  @@index([userId, status, targetDate])
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum ProgressMode {
  MILESTONES
  TASKS
  MANUAL
}

model Milestone {
  id          String    @id @default(uuid(7)) @db.Uuid
  goalId      String    @db.Uuid
  title       String    @db.VarChar(120)
  dueDate     DateTime? @db.Date
  completedAt DateTime? @db.Timestamptz(3)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  goal  Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([goalId, sortOrder])
}

// FR-GOAL-004: habits that count towards a goal (shown on it; progress doesn't use them).
model GoalHabit {
  goalId  String @db.Uuid
  habitId String @db.Uuid

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@id([goalId, habitId])
  @@index([habitId])
}

// ───────────── Progress (XP; gamification pieces brought forward for the quest path) ─────────────

// One row per award. The unique key makes awards safe to repeat (a task completed twice pays
// once); undoing deletes the row, so the total is always the sum of what still stands.
model XpEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  source    XpSource
  sourceKey String   @db.VarChar(80) // task id, "habitId:YYYY-MM-DD", or a chest key
  amount    Int      @db.SmallInt
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceKey])
}

enum XpSource {
  TASK
  HABIT
  CHEST
}
