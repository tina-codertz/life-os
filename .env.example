# Copy to .env (git-ignored) and adjust. Values here are local-development defaults only.
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=lifeos_dev_password
POSTGRES_DB=lifeos_dev
POSTGRES_PORT=5433

DATABASE_URL=postgresql://lifeos:lifeos_dev_password@localhost:5433/lifeos_dev
DATABASE_URL_TEST=postgresql://lifeos:lifeos_dev_password@localhost:5433/lifeos_test

# API: required. Generate your own, never reuse this example value: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-the-output-of-openssl-rand-base64-48

# Email (required). Locally: Mailpit from docker-compose, inbox at http://localhost:8025
SMTP_URL=smtp://localhost:1025

# API (optional; defaults shown)
# NODE_ENV=development
# PORT=3000
# LOG_LEVEL=info
# MAIL_FROM="Life OS <no-reply@lifeos.local>"
# Where links in emails point; the app opens lifeos://verify-email?token=… (Phase 5)
# EMAIL_LINK_BASE_URL=lifeos://
